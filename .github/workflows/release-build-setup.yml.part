- name: Install Rust toolchain
  uses: dtolnay/rust-toolchain@stable
# Restore-only: this workflow runs on tag pushes, and a cache written on
# refs/tags/x cannot be read from the next tag, so a save here would be dead
# weight. The per-target entries are written from `main` by cache-warm-release.yml
# (the target is in the key: two targets share a runner os/arch on Linux X64 and macOS).
- name: Restore cargo + sccache cache
  uses: ./.github/actions/rust-cache-restore
  with:
    key-prefix: sccache-rust-release-${{ join(matrix.targets, '-') }}
    # 6 targets x (1G + ~cargo registry) + the CI entry (2G) ~= the 10GB repo quota
    cache-size: 1G
- name: Add gettid shim for glibc < 2.30 (manylinux_2_28)
  # gettid() glibc wrapper was added in glibc 2.30; recent Rust stdlib references it directly.
  # Compile a shim so lld can resolve the symbol when building on old glibc.
  if: runner.os == 'Linux'
  shell: bash
  run: |
    if ! nm -D /lib64/libc.so.6 2>/dev/null | grep -qw gettid; then
      printf '#define _GNU_SOURCE\n#include <unistd.h>\n#include <sys/syscall.h>\npid_t gettid(void){return (pid_t)syscall(SYS_gettid);}\n' \
        | gcc -x c - -c -o /tmp/gettid_shim.o
      ar rcs /tmp/libgettid_shim.a /tmp/gettid_shim.o
      echo "RUSTFLAGS=${RUSTFLAGS} -C link-arg=-L/tmp -C link-arg=-lgettid_shim" >> "$GITHUB_ENV"
    fi
